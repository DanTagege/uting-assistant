# ---- 服务 ----
UC_HOST=127.0.0.1
UC_PORT=8710
UC_TZ=Asia/Shanghai

# ---- 安全 ----
# 不填则首次启动自动生成到 data/secret.key
UC_SECRET_KEY=
UC_JWT_TTL=7200
UC_RT_TTL=2592000          # 30 天
UC_CSRF=1                  # 非 GET 请求必须带 X-UCampus-Request: 1
UC_CAPTCHA=off             # off | static（static 时用 UC_CAPTCHA_ANSWER 校验）
UC_CAPTCHA_ANSWER=1234
UC_ADMIN_USERS=13900000000 # 逗号分隔，首次登录这些手机号即授予管理员

# ---- 上游 ----
# mock   : 离线假上游（默认，跑通全链路用）
# unipus : 真实 U听说（sso.unipus.cn / ucloud.unipus.cn / uadaptive.unipus.cn）
UC_UPSTREAM=mock
UC_UPSTREAM_TIMEOUT=25
UC_U_APP_ID=116
# 真实上游默认 dry-run：只取卷+组答案+打印将要提交的 body，不真正交卷
UC_REAL_SUBMIT=0
# 需要时覆盖网关（一般不用改）
# UC_UCLOUD_ORIGIN=https://ucloud.unipus.cn
# UC_ADAPTIVE_ORIGIN=https://uadaptive.unipus.cn

# ---- 调度默认值（可在管理端改） ----
UC_SCHEDULER=1
UC_WEEKDAY=0
UC_HOUR=12
UC_MINUTE=0
UC_PARALLELISM=8
UC_TICK=20
UC_WEEKLY_QUOTA=5

# ---- 风控 ----
UC_RISK_WINDOW_DAYS=30
UC_RISK_THRESHOLD=3
